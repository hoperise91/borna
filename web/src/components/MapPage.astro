---
import Base from "../layouts/Base.astro";
import { routes, strings, type Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = strings[lang];
const examples = ["DN1 km 27+400", "DN12", "DJ103", "Covasna"];
const layers = [
  ["category", s.layer_category], ["surface", s.layer_surface], ["maxspeed", s.layer_maxspeed],
  ["aadt", s.layer_aadt], ["quality", s.layer_quality],
];
---
<Base lang={lang} page="map" fullscreen>
  <main
    class="app"
    id="app"
    data-lang={lang}
    data-strings={JSON.stringify(s)}
    data-road-url={routes[lang].road}
  >
    <aside class="side" aria-label={s.browse_counties}>
      <form class="search" role="search" id="search-form">
        <label class="visually-hidden" for="q">{s.search_placeholder}</label>
        <svg class="search-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="q" class="field" type="search" autocomplete="off" spellcheck="false"
          placeholder={s.search_placeholder} />
        <button type="button" class="clear" id="q-clear" aria-label={s.close} hidden>×</button>
      </form>

      <div class="view" id="view" aria-live="polite">
        <section data-view="home">
          <p class="hint small muted">
            {s.search_hint}
            {examples.map((e) => <button type="button" class="chip" data-example={e}>{e}</button>)}
          </p>
          <h2 class="side-h">{s.browse_counties}</h2>
          <ul class="county-list" id="county-list"></ul>
          <p class="small muted click-hint">{s.click_hint}</p>
        </section>
      </div>
    </aside>

    <div class="map-wrap">
      <div id="map" class="map" role="region" aria-label={s.nav_map}></div>
      <div class="layer-switch" role="radiogroup" aria-label={s.layers}>
        {layers.map(([id, label], i) => (
          <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-layer={id}>{label}</button>
        ))}
      </div>
      <div class="legend" id="legend"></div>
    </div>
  </main>
</Base>

<script>
  import { initMap } from "../scripts/map";
  initMap(document.getElementById("app")!);
</script>

<style is:global>
  body.fullscreen { overflow: hidden; }
  .app {
    display: grid;
    grid-template-columns: 380px 1fr;
    height: calc(100dvh - var(--header-h));
  }
  .side {
    display: flex; flex-direction: column;
    background: var(--panel);
    border-right: 1px solid var(--line);
    min-height: 0;
    z-index: 2;
  }
  .search { position: relative; padding: 14px 14px 10px; }
  .search-icon { position: absolute; left: 27px; top: 26px; width: 18px; height: 18px; color: var(--ink-3); pointer-events: none; }
  .search .clear {
    position: absolute; right: 22px; top: 21px; width: 28px; height: 28px; border: 0;
    background: transparent; font-size: 20px; color: var(--ink-3); cursor: pointer; border-radius: 50%;
  }
  .search .clear:hover { background: var(--paper); color: var(--ink); }
  .view { flex: 1; overflow-y: auto; padding: 0 14px 20px; }
  .view section { animation: rise .22s ease-out; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .hint { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 2px 0 18px; }
  .side-h { font-size: 19px; margin: 6px 0 10px; color: var(--ink); }
  .click-hint { margin-top: 18px; }

  .county-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; }
  .county-list button {
    width: 100%; display: flex; justify-content: space-between; align-items: baseline; gap: 8px;
    padding: 7px 10px; border: 0; border-radius: 7px; background: transparent; cursor: pointer;
    text-align: left; font-size: 14.5px;
  }
  .county-list button:hover { background: var(--paper); }
  .county-list .n { font: 12px var(--font-mono); color: var(--ink-3); }

  .back {
    display: inline-flex; align-items: center; gap: 4px; border: 0; background: none; cursor: pointer;
    color: var(--ink-2); padding: 4px 0; margin-bottom: 6px; font-size: 14px;
  }
  .back:hover { color: var(--ink); }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 12px; }

  .road-list { list-style: none; margin: 0; padding: 0; }
  .road-list li + li { border-top: 1px solid var(--line); }
  .road-item {
    width: 100%; display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; align-items: start;
    padding: 10px 6px; border: 0; background: none; cursor: pointer; text-align: left; border-radius: 6px;
  }
  .road-item:hover, .road-item:focus-visible { background: var(--paper); }
  .road-item .route { font-size: 13.5px; color: var(--ink-2); line-height: 1.35; }
  .road-item .meta { grid-column: 2; font-size: 12px; color: var(--ink-3); }
  .road-item.missing .shield { opacity: .45; }

  .detail-head { display: flex; gap: 12px; align-items: center; margin: 4px 0 6px; }
  .detail-head h2 { font-size: 22px; }
  .detail-route { color: var(--ink-2); margin: 0 0 14px; line-height: 1.4; }
  .here {
    display: flex; align-items: baseline; gap: 10px; padding: 10px 12px; margin: 0 0 14px;
    border-radius: 9px; background: color-mix(in srgb, var(--hl) 28%, var(--panel));
    border: 1px solid color-mix(in srgb, var(--hl) 60%, var(--line));
  }
  .here .km { font-size: 22px; font-weight: 500; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0 0 16px; font-size: 14px; }
  .facts dt { color: var(--ink-3); }
  .facts dd { margin: 0; }
  .qbar { display: flex; height: 6px; border-radius: 3px; overflow: hidden; margin-top: 5px; background: var(--line); }
  .goto { display: flex; gap: 8px; margin: 4px 0 16px; }
  .goto input { flex: 1; padding: 8px 10px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--panel); font-family: var(--font-mono); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 8px; }
  .mini-strip { margin: 6px 0 4px; }
  .mini-legend { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12px; color: var(--ink-3); }
  .src { font-size: 12px; color: var(--ink-3); margin-top: 14px; }
  .msg { color: var(--ink-2); padding: 8px 2px; }

  .map-wrap { position: relative; min-width: 0; }
  .map-wrap .map { position: absolute; inset: 0; background: var(--paper); } /* beats .maplibregl-map */
  .layer-switch {
    position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 2px; padding: 3px; border-radius: 999px;
    background: color-mix(in srgb, var(--panel) 94%, transparent); box-shadow: var(--shadow);
    border: 1px solid var(--line); backdrop-filter: blur(6px);
  }
  .layer-switch button {
    border: 0; background: transparent; padding: 6px 13px; border-radius: 999px; cursor: pointer;
    font-size: 13.5px; font-weight: 500; color: var(--ink-2); white-space: nowrap;
  }
  .layer-switch button:hover { color: var(--ink); }
  .layer-switch button[aria-checked="true"] { background: var(--ink); color: var(--paper); }
  .legend {
    position: absolute; left: 12px; bottom: 28px; padding: 10px 12px; border-radius: 10px;
    background: color-mix(in srgb, var(--panel) 94%, transparent); box-shadow: var(--shadow);
    border: 1px solid var(--line); font-size: 12.5px; min-width: 150px;
  }
  .legend .row { display: flex; align-items: center; gap: 8px; line-height: 1.7; }
  .legend .sw { width: 22px; height: 5px; border-radius: 3px; flex: none; }
  .map-wrap .maplibregl-popup-content {
    font-family: var(--font-body); border-radius: 9px; padding: 8px 11px;
    background: var(--panel); color: var(--ink); box-shadow: var(--shadow);
  }
  .map-wrap .maplibregl-popup-anchor-bottom .maplibregl-popup-tip { border-top-color: var(--panel); }
  .map-wrap .maplibregl-popup-anchor-top .maplibregl-popup-tip { border-bottom-color: var(--panel); }
  .map-wrap .maplibregl-popup-anchor-left .maplibregl-popup-tip { border-right-color: var(--panel); }
  .map-wrap .maplibregl-popup-anchor-right .maplibregl-popup-tip { border-left-color: var(--panel); }
  .map-wrap .maplibregl-popup-content .km { font-weight: 500; margin-left: 4px; }
  .maplibregl-ctrl-attrib { font-size: 11px; }
  .km-pin {
    width: 18px; height: 18px; border-radius: 50%; background: var(--ink); border: 3px solid var(--hl);
    box-shadow: 0 0 0 4px rgba(0,0,0,.15);
  }

  @media (max-width: 860px) {
    body.fullscreen { overflow: auto; }
    .app { grid-template-columns: 1fr; grid-template-rows: 52dvh auto; height: auto; }
    .map-wrap { grid-row: 1; height: 52dvh; }
    .side { grid-row: 2; border-right: 0; border-top: 1px solid var(--line); min-height: 48dvh; }
    .view { overflow: visible; }
    .layer-switch { left: 8px; right: 8px; transform: none; overflow-x: auto; justify-content: flex-start; }
    .legend { bottom: 10px; left: 8px; }
  }
</style>
