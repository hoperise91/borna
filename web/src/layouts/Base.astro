---
import "../styles/global.css";
import { routes, strings, type Lang, type Page } from "../lib/i18n";

interface Props {
  lang: Lang;
  page: Page;
  title?: string;
  description?: string;
  fullscreen?: boolean;
}
const { lang, page, title, description, fullscreen = false } = Astro.props;
const s = strings[lang];
const r = routes[lang];
const other: Lang = lang === "ro" ? "en" : "ro";
const pageTitle = title ? `${title} · Bornă` : `Bornă · ${s.tagline}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? s.tagline} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang={other} href={routes[other][page]} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={fullscreen ? "fullscreen" : ""}>
    <header class="site-header">
      <a class="brand" href={r.map} aria-label="Bornă">
        <svg class="brand-mark" viewBox="0 0 22 30" aria-hidden="true">
          <path d="M3 9 Q3 2 11 2 Q19 2 19 9 Z" fill="var(--accent)" />
          <rect x="3" y="9" width="16" height="19" rx="1.5" fill="var(--panel)" stroke="var(--ink)" stroke-width="1.6" />
          <path d="M3 9 Q3 2 11 2 Q19 2 19 9" fill="none" stroke="var(--ink)" stroke-width="1.6" />
          <rect x="6.5" y="14" width="9" height="2" fill="var(--ink)" />
          <rect x="6.5" y="19" width="6" height="2" fill="var(--ink)" />
        </svg>
        <span class="brand-name">Bornă</span>
        <span class="brand-tag">{s.tagline}</span>
      </a>
      <nav class="site-nav" aria-label="Bornă">
        <a href={r.map} aria-current={page === "map" ? "page" : undefined}>{s.nav_map}</a>
        <a href={r.data} aria-current={page === "data" ? "page" : undefined}>{s.nav_data}</a>
        <a href={r.about} aria-current={page === "about" ? "page" : undefined}>{s.nav_about}</a>
        <a class="lang" href={routes[other][page]} hreflang={other} lang={other} data-keep-query>{s.other_lang}</a>
      </nav>
    </header>
    <slot />
    <script>
      // Keep the selected road (?r=, ?km=) when switching language.
      document.querySelectorAll<HTMLAnchorElement>("a[data-keep-query]").forEach((a) => {
        a.addEventListener("click", () => {
          if (location.search) a.href = a.pathname + location.search;
        });
      });
    </script>
  </body>
</html>
